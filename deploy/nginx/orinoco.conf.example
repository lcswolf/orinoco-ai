# Install as /etc/nginx/conf.d/orinoco.conf.
# This file is included from Nginx's http {} context on a standard Ubuntu install.
# Replace 28080 with the actual host-side Pterodactyl allocation for Orinoco.
# Caddy is the only public proxy; Nginx itself binds to loopback only.

limit_req_zone $binary_remote_addr zone=orinoco_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=orinoco_chat:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=orinoco_api:10m rate=60r/m;
limit_conn_zone $binary_remote_addr zone=orinoco_connections:10m;

upstream orinoco_app {
    server 127.0.0.1:28080; # Pterodactyl host allocation; replace before use.
    keepalive 16;
}

server {
    listen 127.0.0.1:8081;
    server_name _;

    # Only trust forwarded client addresses from the local Caddy listener.
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Global application request limit; upload routes are stricter below.
    client_max_body_size 12m;
    client_body_timeout 20s;
    limit_conn orinoco_connections 20;
    limit_req_status 429;
    limit_conn_status 429;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Pass only the address Nginx resolved from the trusted local proxy.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header Connection "";

    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    # Model responses can be slow on the initial low-memory VPS.
    proxy_read_timeout 300s;
    send_timeout 300s;
    proxy_buffering off;

    location = /api/auth/login {
        limit_req zone=orinoco_api burst=20 nodelay;
        limit_req zone=orinoco_login burst=5 nodelay;
        proxy_pass http://orinoco_app;
    }

    location = /api/chat {
        limit_req zone=orinoco_api burst=30 nodelay;
        limit_req zone=orinoco_chat burst=10 nodelay;
        proxy_pass http://orinoco_app;
    }

    location ^~ /api/documents {
        client_max_body_size 11m;
        limit_req zone=orinoco_api burst=20 nodelay;
        proxy_pass http://orinoco_app;
    }

    location ^~ /api/admin/shared-documents {
        client_max_body_size 11m;
        limit_req zone=orinoco_api burst=20 nodelay;
        proxy_pass http://orinoco_app;
    }

    location ^~ /api/ {
        limit_req zone=orinoco_api burst=30 nodelay;
        proxy_pass http://orinoco_app;
    }

    location / {
        proxy_pass http://orinoco_app;
    }
}
