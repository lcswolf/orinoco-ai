# Replace with the exact immutable image tag in the release notes.
ORINOCO_IMAGE=ghcr.io/lcswolf/orinoco-ai:REPLACE_WITH_RELEASE_TAG

# The Compose example binds this port to host loopback only.
ORINOCO_PORT=8000

# Generate with: openssl rand -hex 32
ORINOCO_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_TOKEN

TIMEZONE=Europe/London
AI_MODEL=qwen2.5:0.5b
AUTO_DOWNLOAD_MODEL=false
MODEL_CONTEXT=1024
AUTO_SAVE_MEMORIES=false
ENABLE_WEB_SEARCH=false

# Optional Orinoco scheduler; leave disabled if using another backup system.
ORINOCO_BACKUP_ENABLED=false
# Set only when encrypted backup features are configured.
ORINOCO_BACKUP_KEY=
